    "test": "tsx --import ./scripts/test-env.mjs --test --test-concurrency=4 tests/*.test.ts",
    "owner:setup": "tsx scripts/owner-setup.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@typesafe-ai/sdk": "0.6.0",
    "cookie-parser": "1.4.7",
