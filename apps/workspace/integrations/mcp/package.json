{
  "name": "@stjw/local-read-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP bridge for existing scoped STJW reads",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:workspace": "npm run build && node scripts/test-workspace.mjs",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
